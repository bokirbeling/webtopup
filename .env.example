# App runtime
NODE_ENV=development
PORT=3001

# Supabase
SUPABASE_URL=your_value_here
SUPABASE_SERVICE_ROLE_KEY=your_value_here
# Use demo_ for development/demo data isolation. Leave empty in production.
SUPABASE_TABLE_PREFIX=demo_

# Midtrans
MIDTRANS_SERVER_KEY=your_value_here
MIDTRANS_API_BASE_URL=https://app.sandbox.midtrans.com

# Digiflazz
DIGIFLAZZ_USERNAME=your_value_here
DIGIFLAZZ_API_KEY=your_value_here
DIGIFLAZZ_API_BASE_URL=https://api.digiflazz.com
# Optional webhook HMAC secret. Leave empty to accept unsigned Digiflazz callbacks.
DIGIFLAZZ_WEBHOOK_SECRET=
# Optional server-side prepaid topup controls. Never source these from client payloads.
DIGIFLAZZ_TOPUP_TESTING=
DIGIFLAZZ_TOPUP_MAX_PRICE=
DIGIFLAZZ_TOPUP_CALLBACK_URL=
DIGIFLAZZ_TOPUP_ALLOW_DOT=

# Auth
JWT_SECRET=replace_with_at_least_32_random_characters
JWT_EXPIRES_IN=1h
PASSWORD_HASH_COST=12
# Optional; reserved for future server-side admin bootstrap flows only.
ADMIN_BOOTSTRAP_TOKEN=


# SMTP sender-only account for email verification. Use one cPanel mailbox such as no-reply@adnanpay.com.
# Do not create cPanel mailboxes per app user/reseller.
SMTP_HOST=mail.adnanpay.com
SMTP_PORT=465
SMTP_USER=no-reply@adnanpay.com
SMTP_PASSWORD=your_value_here
SMTP_FROM_EMAIL=no-reply@adnanpay.com
SMTP_FROM_NAME=Adnanpay

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Frontend
VITE_API_BASE_URL=/ppob-api
