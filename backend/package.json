{
  "name": "ppob-backend",
  "version": "1.0.0",
  "private": true,
  "description": "PPOB backend workspace skeleton",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --runInBand",
    "test:feature": "playwright test --config=playwright.config.ts",
    "test:feature:guest": "playwright test playwright-tests/guest.spec.ts --config=playwright.config.ts",
    "test:feature:reseller": "playwright test playwright-tests/reseller.spec.ts --config=playwright.config.ts",
    "test:feature:admin": "playwright test playwright-tests/admin.spec.ts --config=playwright.config.ts",
    "test:feature:backend": "tsx playwright-tests/run-backend-checks.ts",
    "start": "node dist/index.js",
    "scrape-products": "tsx src/scripts/scrape-digiflazz-products.ts",
    "import-products": "tsx src/scripts/import-digiflazz-products.ts",
    "import-all-batches": "tsx src/scripts/import-all-batches.ts",
    "download-images": "tsx src/scripts/download-product-images.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@supabase/supabase-js": "^2.105.4",
    "@types/nodemailer": "^8.0.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.22.3",
    "nodemailer": "^8.0.7",
    "pg": "^8.20.0",
    "ws": "^8.20.1",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.55.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.6.0",
    "@types/supertest": "^6.0.3",
    "@types/ws": "^8.18.1",
    "eslint": "^10.2.1",
    "jest": "^30.3.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.0"
  }
}
