# Default same-origin API path:
NEXT_PUBLIC_API_BASE_URL=/ppob-api

# Local backend override when running frontend against a separate local API:
# NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Frontend-safe env only. Do not add service-role, Digiflazz, Midtrans server,
# SMTP password, JWT secret, SSH key, or passphrase values here.
